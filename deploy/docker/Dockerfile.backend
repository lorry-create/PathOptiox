FROM python:3.10-slim

WORKDIR /app

# 配置国内 PyPI 镜像源（清华源，加速依赖下载）
RUN pip install --upgrade pip -i https://pypi.tuna.tsinghua.edu.cn/simple --trusted-host pypi.tuna.tsinghua.edu.cn

# 0/3 安装构建依赖（orjson/greenlet 等 C 扩展需要编译工具链 + Python 头文件）
RUN sed -i 's|deb.debian.org|mirrors.aliyun.com|g' /etc/apt/sources.list.d/debian.sources \
    && apt-get update && apt-get install -y --no-install-recommends \
        build-essential gcc python3-dev \
    && rm -rf /var/lib/apt/lists/*

# 1/3 先安装 CPU-only PyTorch（不含 CUDA 工具包，~200MB vs GPU版 ~3GB+）
RUN pip install --no-cache-dir torch -i https://pypi.tuna.tsinghua.edu.cn/simple --trusted-host pypi.tuna.tsinghua.edu.cn \
    --index-url https://download.pytorch.org/whl/cpu

# 2/3 安装生产依赖（不含 pytest 等测试依赖，torch 已跳过）
COPY backend/requirements-prod.txt ./
RUN pip install --no-cache-dir -r requirements-prod.txt -i https://pypi.tuna.tsinghua.edu.cn/simple --trusted-host pypi.tuna.tsinghua.edu.cn \
    && rm -f requirements-prod.txt

# 3/3 清理构建依赖以减小镜像体积
RUN apt-get purge -y build-essential gcc && apt-get autoremove -y && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

COPY static ./static
COPY backend/ .

EXPOSE 8010

ENV PYTHONUNBUFFERED=1
ENV PORT=8010

CMD ["python", "main.py"]
